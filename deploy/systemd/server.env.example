# systemd EnvironmentFile syntax (not a shell script); do not put passwords here.
KEYROTATION_BINARY=/usr/local/bin/keyrotation-server
KEYROTATION_DATA_DIR=/var/lib/keyrotation-server
KEYROTATION_LISTEN=0.0.0.0:4233
KEYROTATION_PUBLIC_URL=http://REPLACE_WITH_REAL_IP_OR_HOST:4233/
# HTTPS only: set both PEM paths, readable by the keyrotation user.
# KEYROTATION_TLS_CERT=/etc/keyrotation-server/server.pem
# KEYROTATION_TLS_KEY=/etc/keyrotation-server/server.key
