[Unit]
Description=Keyrotation API server
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
User=keyrotation
Group=keyrotation
StateDirectory=keyrotation-server
StateDirectoryMode=0700
WorkingDirectory=/var/lib/keyrotation-server
Environment=KEYROTATION_DATA_DIR=/var/lib/keyrotation-server
EnvironmentFile=/etc/keyrotation-server/server.env
ExecStart=/usr/local/libexec/keyrotation-server-service
Restart=on-failure
RestartSec=2s
TimeoutStopSec=20s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
